    "mobile:build:android": "python3 scripts/build-android.py",
    "build:preview": "node scripts/build-preview.mjs",
    "test:preview": "npm run build:preview && playwright test -c playwright.preview.config.ts",
    "test:config": "node tests/config/browser-env.test.mjs",
