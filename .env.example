# Browser-safe Supabase project settings. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Existing GEMINI_API_KEY configuration is retained; no change is needed here.

# Firebase is used exclusively for Cloud Messaging, never for app data or authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Server-only FCM credentials belong in Supabase Edge Function secrets, NOT VITE_ variables.
# FCM_SERVICE_ACCOUNT and NOTIFICATION_WORKER_SECRET: see docs/PRODUCTION.md.
